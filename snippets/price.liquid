{%- comment -%}
  Renders a product price.
  Accepts:
  - price_product: {Object} Product object
  - use_variant: {Boolean} Use selected_or_first_available_variant prices instead of product min price
{%- endcomment -%}

{%- liquid
  if use_variant
    assign target = price_product.selected_or_first_available_variant
    assign price = target.price
    assign compare_at_price = target.compare_at_price
  else
    assign price = price_product.price
    assign compare_at_price = price_product.compare_at_price
  endif
-%}

{%- if compare_at_price > price -%}
  <span class="price price--sale">{{ price | money }}</span>
  <s class="price price--compare">{{ compare_at_price | money }}</s>
{%- else -%}
  {%- if use_variant != true and price_product.price_varies -%}
    <span class="price">From {{ price | money }}</span>
  {%- else -%}
    <span class="price">{{ price | money }}</span>
  {%- endif -%}
{%- endif -%}
