[
  {
    "name": "theme_info",
    "theme_name": "Blue Diamond",
    "theme_version": "1.0.0",
    "theme_author": "Blue Diamond Co",
    "theme_documentation_url": "https://github.com/baalhamm/expert-sniffle",
    "theme_support_url": "https://github.com/baalhamm/expert-sniffle/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0b0d10"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, panels)",
        "default": "#14181d"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#f4f2ec"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (diamond blue)",
        "default": "#8ecfee"
      },
      {
        "type": "color",
        "id": "color_accent_contrast",
        "label": "Text on accent",
        "default": "#0b0d10"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 160
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  }
]
