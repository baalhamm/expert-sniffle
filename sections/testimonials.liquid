<section class="section testimonials">
  <div class="page-width">
    <header class="section__header">
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    </header>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-label="5 out of 5 stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8L12 2z"/></svg>
            {%- endfor -%}
          </div>
          <blockquote class="testimonial-card__quote">{{ block.settings.quote | escape }}</blockquote>
          <figcaption class="testimonial-card__author">{{ block.settings.author | escape }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our clients say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Outstanding craftsmanship and service from start to finish. My piece exceeded every expectation."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Verified client"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
