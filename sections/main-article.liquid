<article class="section main-article">
  <div class="page-width page-width--narrow">
    <header class="collection-header">
      <h1 class="collection-header__title">{{ article.title | escape }}</h1>
      <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
    </header>
    {%- if article.image -%}
      <div class="main-article__image">
        {{ article.image | image_url: width: 1400 | image_tag: alt: article.title | escape }}
      </div>
    {%- endif -%}
    <div class="rte">
      {{ article.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article page",
  "settings": []
}
{% endschema %}
