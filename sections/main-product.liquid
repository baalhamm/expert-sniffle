<section class="section main-product">
  <div class="page-width">
    <div class="main-product__grid">
      <div class="main-product__media">
        {%- if product.media.size > 0 -%}
          <div class="main-product__gallery">
            {%- for media in product.media -%}
              <div class="main-product__media-item{% if forloop.first %} is-active{% endif %}" data-media-index="{{ forloop.index0 }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {{ media | image_url: width: 1400 | image_tag: widths: '500, 750, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | escape }}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="main-product__thumbs">
              {%- for media in product.media -%}
                <button type="button" class="main-product__thumb{% if forloop.first %} is-active{% endif %}" data-thumb-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: alt: media.alt | escape }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="main-product__info">
        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <p class="main-product__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <h1 class="main-product__title">{{ product.title | escape }}</h1>

        <div class="main-product__price" id="ProductPrice">
          {% render 'price', price_product: product, use_variant: true %}
        </div>

        {% form 'product', product, class: 'main-product__form' %}
          {%- unless product.has_only_default_variant -%}
            <div class="main-product__field">
              <label for="ProductVariantSelect">Options</label>
              <select id="ProductVariantSelect" name="id" class="select">
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} &mdash; {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- endunless -%}

          <div class="main-product__field">
            <label for="ProductQuantity">Quantity</label>
            <div class="quantity">
              <button type="button" class="quantity__button" data-quantity-change="-1" aria-label="Decrease quantity">&minus;</button>
              <input id="ProductQuantity" class="quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" class="quantity__button" data-quantity-change="1" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <button
            type="submit"
            name="add"
            class="button button--primary button--full"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {%- if product.selected_or_first_available_variant.available -%}
              Add to cart
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>

          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        {% endform %}

        {%- if product.description != blank -%}
          <div class="main-product__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'detail' -%}
              <details class="main-product__detail" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title | escape }}</summary>
                <div class="rte">{{ block.settings.content }}</div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Collapsible detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Complimentary fully-insured worldwide delivery. Returns accepted within 14 days in original condition.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
