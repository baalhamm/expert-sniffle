<section class="section newsletter">
  <div class="page-width newsletter__inner">
    <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success" tabindex="-1" autofocus>Thank you for subscribing.</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="NewsletterEmail" class="visually-hidden">Email address</label>
          <input
            id="NewsletterEmail"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="Your email address"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >
          <button type="submit" class="button button--primary">Subscribe</button>
        </div>
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Blue Diamond circle"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Be the first to discover new arrivals, private releases and exclusive events."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
