<section class="section collection-list">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}
    <div class="collection-list__grid collection-list__grid--{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <a
          class="collection-card"
          href="{{ collection.url | default: routes.collections_url }}"
          {{ block.shopify_attributes }}
        >
          <div class="collection-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'collection-card__image', widths: '400, 600, 800, 1000', alt: block.settings.title | default: collection.title | escape }}
            {%- elsif collection.featured_image != blank -%}
              {{ collection.featured_image | image_url: width: 1000 | image_tag: class: 'collection-card__image', widths: '400, 600, 800, 1000', alt: collection.title | escape }}
            {%- else -%}
              {%- capture placeholder -%}collection-{{ forloop.index }}{%- endcapture -%}
              {{ placeholder | placeholder_svg_tag: 'collection-card__image placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-card__label">
            <span class="collection-card__title">{{ block.settings.title | default: collection.title | default: 'Collection' }}</span>
            <span class="collection-card__cta">Explore</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Leave blank to use the collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Leave blank to use the collection image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
